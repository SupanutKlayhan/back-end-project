PORT=3000
DATABASE_URL=mysql://root:rootpass@127.0.0.1:3307/hotel_booking
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=big-important-secret
TRUST_PROXY=false
RUN_SEED=false
UPLOAD_DIR=/app/uploads
DISABLE_CACHE=false
DISABLE_THROTTLE=false

# seed account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User1234!

# docker compose
DB_NAME=hotel_booking
